{
  "alert": "Storefront checkout p99 latency above 3s",
  "alertType": "TRACES_BASED_ALERT",
  "description": "p99 duration of storefront's POST /checkout server spans, averaged over 5 minutes, is above 3 seconds.",
  "ruleType": "threshold_rule",
  "version": "v5",
  "schemaVersion": "v2alpha1",
  "condition": {
    "compositeQuery": {
      "queryType": "builder",
      "panelType": "graph",
      "unit": "ns",
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "traces",
            "stepInterval": 60,
            "aggregations": [
              {
                "expression": "p99(duration_nano)"
              }
            ],
            "filter": {
              "expression": "service.name = 'storefront' AND name = 'POST /checkout' AND kind_string = 'Server'"
            },
            "groupBy": [
              {
                "name": "service.name",
                "fieldContext": "resource",
                "fieldDataType": "string"
              }
            ],
            "legend": "{{service.name}} POST /checkout"
          }
        }
      ]
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "warning",
          "op": "above",
          "matchType": "on_average",
          "target": 3,
          "targetUnit": "s",
          "channels": []
        }
      ]
    }
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "5m",
      "frequency": "1m"
    }
  },
  "notificationSettings": {
    "groupBy": [
      "service.name"
    ],
    "renotify": {
      "enabled": false,
      "interval": "30m",
      "alertStates": [
        "firing"
      ]
    },
    "usePolicy": true
  },
  "labels": {
    "severity": "warning",
    "source": "wasitus-lab"
  },
  "annotations": {
    "summary": "Checkout p99 latency above {{$threshold}}s",
    "description": "storefront POST /checkout p99 is {{$value}} over the last 5 minutes."
  }
}
